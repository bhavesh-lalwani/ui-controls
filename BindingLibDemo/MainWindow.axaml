<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:BindingLibDemo"
        xmlns:bl="using:BindingLib.Controls"
        x:Class="BindingLibDemo.MainWindow"
        x:DataType="local:MainViewModel"
        Title="BindingLib Demo — DataGrid + Tree"
        Width="1100" Height="750"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F1A">

    <Window.Styles>
        <Style Selector="Button.act">
            <Setter Property="Background" Value="#1E1E38"/>
            <Setter Property="Foreground" Value="#C0CFFF"/>
            <Setter Property="BorderBrush" Value="#3A3A60"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10 5"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.act:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2E2E58"/>
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#3A1020"/>
            <Setter Property="Foreground" Value="#FF8090"/>
            <Setter Property="BorderBrush" Value="#6A2030"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10 5"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#1A3A6A"/>
            <Setter Property="Foreground" Value="#80C0FF"/>
            <Setter Property="BorderBrush" Value="#2A5A9A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10 5"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBox.search">
            <Setter Property="Background" Value="#1A1A30"/>
            <Setter Property="Foreground" Value="#D0D8FF"/>
            <Setter Property="BorderBrush" Value="#3A3A60"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="8 5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6070A0"/>
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#C0D0FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" Background="#090914" Padding="18 12" BorderBrush="#1E1E3A" BorderThickness="0 0 0 1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="📦" FontSize="24" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="BindingLib Demo" FontSize="18" FontWeight="Bold" Foreground="#90B0FF"/>
                        <TextBlock Text="Separate library project referenced via ProjectReference"
                                   FontSize="11" Foreground="#505080"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#131328" CornerRadius="6" Padding="10 6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastAction}" FontSize="11" Foreground="#7080C0"
                               MaxWidth="400" TextTrimming="CharacterEllipsis"/>
                </Border>
            </Grid>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Background="Transparent">

            <!-- DataGrid Tab -->
            <TabItem Header="⬛  DataGrid">
                <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="14 10">

                    <!-- Toolbar -->
                    <Border Grid.Row="0" Background="#0D0D20" CornerRadius="7" Padding="10 8" Margin="0 0 0 8">
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0 0 12 0">
                                <TextBlock Text="Source:" Classes="label" VerticalAlignment="Center" Margin="0 0 4 0"/>
                                <Button Classes="primary" Content="📋 DataTable"    Click="OnSwitchDataTable"/>
                                <Button Classes="act"     Content="📝 List&lt;T&gt;" Click="OnSwitchList"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0 0 12 0">
                                <Button Classes="primary" Content="➕ Add Row"    Click="OnAddRow"/>
                                <Button Classes="danger"  Content="🗑 Delete Row" Click="OnDeleteRow"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="🔍" VerticalAlignment="Center"/>
                                <TextBox Classes="search" Width="170" Watermark="Filter name / country…" Text="{Binding FilterText}"/>
                                <Button Classes="act" Content="✕ Clear" Click="OnClearFilter"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <!-- Selected row banner -->
                    <Border Grid.Row="1" Background="#0A2040" CornerRadius="6" Padding="12 8"
                            Margin="0 0 0 8" IsVisible="{Binding ShowRowHighlight}">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="✅ SELECTED: " FontSize="12"
                                       FontWeight="Bold" Foreground="#40C080" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding RowDetail}" FontSize="12"
                                       Foreground="#80D0FF" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- The library control — bl:BindableDataGrid from BindingLib.Controls -->
                    <Border Grid.Row="2" Background="White" CornerRadius="7" ClipToBounds="True">
                        <bl:BindableDataGrid
                            DataSource="{Binding DataSource}"
                            SelectedRow="{Binding SelectedRow, Mode=TwoWay}"
                            AutoGenerateColumns="True"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            MinHeight="300"
                            GridLinesVisibility="All"
                            SelectionMode="Single"> 
                        </bl:BindableDataGrid>   
                    </Border>

                    <!-- Status -->
                    <Border Grid.Row="3" Background="#090914" CornerRadius="5" Padding="10 6" Margin="0 8 0 0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding StatusText}" Classes="label" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Classes="label"
                                       Text="{Binding DataSourceMode, StringFormat='Source: {0}'}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tree Tab -->
            <TabItem Header="🌳  Tree">
                <Grid Margin="14 10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tree + toolbar -->
                    <Grid Grid.Column="0" RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Background="#0D0D20" CornerRadius="7" Padding="8 7" Margin="0 0 0 8">
                            <WrapPanel Orientation="Horizontal">
                                <Button Classes="act"     Content="⬇ Expand"   Click="OnExpandAll"   FontSize="11" Margin="0 0 3 0"/>
                                <Button Classes="act"     Content="⬆ Collapse"  Click="OnCollapseAll" FontSize="11" Margin="0 0 3 0"/>
                                <Button Classes="primary" Content="➕ Add Node"  Click="OnAddNode"    FontSize="11" Margin="0 0 3 0"/>
                                <Button Classes="danger"  Content="🗑 Remove"    Click="OnRemoveNode" FontSize="11"/>
                            </WrapPanel>
                        </Border>

                        <!-- The library control — bl:BindableTreeControl from BindingLib.Controls -->
                        <Border Grid.Row="1" Background="#0D0D20" CornerRadius="7" ClipToBounds="True">
                            <bl:BindableTreeControl
                                Nodes="{Binding TreeNodes}"
                                SelectedNode="{Binding SelectedNode, Mode=TwoWay}"
                                ShowIcons="True"
                                Background="Transparent"
                                Margin="6"/>
                        </Border>
                    </Grid>

                    <!-- Detail + log -->
                    <Grid Grid.Column="2" RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Background="#0D0D20" CornerRadius="7" Padding="16 14" Margin="0 0 0 10">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Selected Node" FontSize="14" FontWeight="Bold" Foreground="#90B0FF"/>
                                <Separator Background="#2A2A4A" Height="1"/>
                                <TextBlock Text="👆 Click any node in the tree."
                                           FontSize="12" Foreground="#506080"
                                           IsVisible="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNull}}"/>
                                <Border Background="#0A2040" CornerRadius="5" Padding="10 8"
                                        IsVisible="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBlock Text="{Binding TreeDetail}" FontSize="12"
                                               Foreground="#80D0FF" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Background="#0D0D20" CornerRadius="7" Padding="12">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Grid.Row="0" Text="📋 Activity Log"
                                           FontSize="13" FontWeight="Bold" Foreground="#90B0FF" Margin="0 0 0 8"/>
                                <ScrollViewer Grid.Row="1">
                                    <ItemsControl ItemsSource="{Binding ActivityLog}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11" Foreground="#5060A0"
                                                           FontFamily="Consolas,Courier New,monospace" Margin="0 2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#080812" BorderBrush="#181830" BorderThickness="0 1 0 0" Padding="14 6">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#5060A0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="BindingLib (separate project)  ·  Avalonia 11  ·  .NET 8"
                           FontSize="10" Foreground="#303050" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
