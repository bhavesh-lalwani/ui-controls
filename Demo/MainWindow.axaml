<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lib="using:Lib"
        xmlns:vm="using:Demo"
        x:Class="Demo.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="BARC App">

    <Grid Margin="20">
        <lib:CustomDataGrid ItemsSource="{Binding People, Mode=TwoWay}" />
    </Grid>
</Window>